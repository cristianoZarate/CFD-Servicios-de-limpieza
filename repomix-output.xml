    try {
      await cancelarReservaApi(reservaId);
      
      alert("Agendamiento cancelado con éxito. Cupo liberado en MySQL.");
      
      setCitas((prev) => prev.filter((cita) => cita.id !== reservaId));
      
      if (filaExpandida === reservaId) {
        setFilaExpandida(null);
      }
    } catch (error) {
